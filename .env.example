# BevPro form-to-email — required env vars
# Set these in Vercel (Settings → Environment Variables → Production) and locally (shell or .env)

# Gmail SMTP sender (existing credentials live in ~/.bashrc on the dev box)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-sender@gmail.com

# Where lead emails land (defaults to info@mybevpro.com if unset)
LEAD_EMAIL=info@mybevpro.com
